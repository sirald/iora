# /etc/iora/borrower.env  (owner root:iora, mode 0640). TESTNET ONLY: the bot refuses any other network.
# The secret key goes here and nowhere else. Generate it on the server; never commit or paste it.
BORROWER_SECRET=
# The bot's public key (G...). The bot stops if BORROWER_SECRET belongs to another account.
BORROWER_ADDRESS=
# Iora's own Blend pool (testnet/blend-pool.env POOL)
BLEND_POOL=CANUGJL73FGXXDE7BVVUCIPM2ETOO2UARG4B3Q2TJKI4FADWJAMLIKXV

# Optional (defaults shown)
# RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# USDC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA        Circle USDC SAC
# USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# COLLATERAL=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC  XLM SAC
# UTIL_TARGET=0.6        target USDC utilisation of the pool
# UTIL_BAND=0.1          act only outside UTIL_TARGET +- UTIL_BAND (50-70%)
# MIN_HF=1.5             below this health factor: repay down to TARGET_HF
# TARGET_HF=2.0          never borrow beyond this health factor
# MAX_DEBT=5000          USDC the bot may owe at most
# COLLATERAL_TARGET=5000 XLM the bot keeps as collateral (topped up from its wallet)
# XLM_RESERVE=50         XLM left in the wallet for fees
# MIN_ACTION=0.5         USD; smaller changes are skipped

# Other coins (multi.js): XLM and Iora's coins at their target supply APR, from targets.json.
# Recommended: a SECOND account and env file (/etc/iora/borrower-multi.env, unit iora-blend-borrower-multi) with
#   USDC_STEP=off, so the USDC bot's health factor and collateral stay as they are. The USDC bot keeps MULTI=off.
# MULTI=on               off: the bot is USDC-only, exactly as before
# USDC_STEP=on           off: skip the USDC step (the second account)
# TARGETS_FILE=targets.json   per-coin targets (relative to the bot's directory)
# MULTI_MIN_HF=1.5       below this health factor the other coins are repaid down to MULTI_TARGET_HF
# MULTI_TARGET_HF=2.0    never borrow the other coins beyond this health factor
# UTIL_OVERSHOOT=0.02    how far above a curve's util the bot may go to lift a low ir_mod
