# /etc/iora/monitor.env (optional; owner root:iora, mode 0640). Settings of the Iora bots check (check-bots.js).
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID come from /etc/iora/heartbeat.env (the keeper heartbeat's chat); do not
# copy them here. Every line is optional: the defaults are shown.

# Which bots to check (take one out while it is stopped on purpose, or it alarms every hour):
# BOTS=price-bot,borrower,borrower-multi

# No successful run for this many minutes = alarm (the price bot runs every 2 min, the borrowers every 10 min):
# PRICE_BOT_MAX_AGE_MIN=15
# BORROWER_MAX_AGE_MIN=45
# Failed runs in a row before "runs fail" is told (a failure the bot could not record is told at once):
# FAILED_RUNS=2
# A pool more than this far from the Reflector price (or not checked at all) in POOL_DEV_RUNS runs in a row:
# MAX_POOL_DEV=0.01
# POOL_DEV_RUNS=3
# A borrower's health factor below this = alarm (nothing liquidates positions in Iora's own pool):
# MIN_HF=1.3

# The site's faucet (Horizon, read only). FAUCET_ADDRESS= (empty) turns the check off.
# FAUCET_ADDRESS=GDWNSKKAMSQZRLV4EGXFMY7QSUQ5EOOXJGUNMLH6H3KFU4B2ZZESSY47
# FAUCET_MIN_USDC=2000
# FAUCET_MIN_XLM=50
# USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# HORIZON_URL=https://horizon-testnet.stellar.org

# The USDC exchange's Circle USDC (a read-only simulation; needs npm ci in /opt/iora/monitor).
# USDC_EXCHANGE= (empty) turns the check off.
# USDC_EXCHANGE=CARNY3MIP5MWSTM5IMQCDDQGNNMUR5UR5VZRGBXSC6NQCV74KWFAAKTT
# EXCHANGE_MIN_USDC=500
# USDC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# RPC_URL=https://soroban-testnet.stellar.org

# Repeats: the same alarm at most every ALARM_REPEAT_MIN minutes, a stock or soft warning every STOCK_REPEAT_H hours.
# ALARM_REPEAT_MIN=60
# STOCK_REPEAT_H=12
# The check's own reading problems (Horizon, RPC, systemd) are told only when they last this many minutes:
# SOFT_DELAY_MIN=10

# Where the status files are (the bots' StateDirectory=), and where the check keeps its own state:
# PRICE_BOT_STATUS=/var/lib/iora/price-bot/status.json
# BORROWER_STATUS=/var/lib/iora/borrower/status.json
# BORROWER_MULTI_STATUS=/var/lib/iora/borrower-multi/status.json
# MONITOR_STATE_FILE=/var/lib/iora/monitor/state.json
# SYSTEMD=auto            off: do not read timers and services (a run on another machine)
