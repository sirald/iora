# /etc/iora/price-bot.env  (owner root:iora, mode 0640). TESTNET ONLY: the bot refuses any other network.
# The secret key goes here and nowhere else. Generate it on the server; never commit or paste it.
PRICE_BOT_SECRET=
# The bot's public key (G...). The bot stops if PRICE_BOT_SECRET belongs to another account.
PRICE_BOT_ADDRESS=

# Optional (defaults shown)
# POOLS_FILE=pools.json   the pools to look after (scripts/price-bot/make-pools.sh), relative to the bot's directory
# ONLY=                   comma-separated pool names to restrict a run to (e.g. XLM,iBTC); empty = all
# RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# ORACLE=                 overrides pools.json's oracle adapter (Reflector prices)
# THRESHOLD=0.005         act only when a pool deviates more than 0.5% from Reflector
# MAX_PRICE_AGE=900       seconds; an older (or missing) oracle price: that pool is left alone
# MAX_TRADE_USD=300       largest swap per pool per run, in USD
# MIN_TRADE_USD=1         smaller swaps are skipped
# XLM_RESERVE=20          XLM never sold (fees)
# WARN_USDC=200           log a WARN line when the bot holds less USDC than this
# WARN_COIN_USD=100       ... or less of a coin than this many USD
# SLIPPAGE=0.005          minimum output = router estimate less this
# FAIR_TOLERANCE=0.003    refuse when the estimate is worse than reference less fee by more than this
