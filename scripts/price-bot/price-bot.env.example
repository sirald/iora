# /etc/iora/price-bot.env  (owner root:iora, mode 0640). TESTNET ONLY: the bot refuses any other network.
# The secret key goes here and nowhere else. Generate it on the server; never commit or paste it.
PRICE_BOT_SECRET=
# The bot's public key (G...). The bot stops if PRICE_BOT_SECRET belongs to another account.
PRICE_BOT_ADDRESS=
# Iora's reference pool (testnet/ref-pool.env REF_POOL / REF_POOL_INDEX)
REF_POOL=CAQ2BULFOKLF6676LGFYRZ6RQK2QCCHZOW5K7UJEXZOJ5RGECDUAITGL
REF_POOL_INDEX=ed45429155f876475d3c7ac18d34273d638d6a5b2fcc736db36d71a5788852c5

# Optional (defaults shown)
# RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org
# AQUA_ROUTER=CBCFTQSPDBAIZ6R6PJQKSQWKNKWH2QIV3I4J72SHWBIK3ADRRAM5A6GD
# ORACLE=CCSZNMAXTNMIZNGDBLIZYKLOZG3LYKSIXCYC7GKWLOBLSMUPX7MKPHDF      Iora's oracle adapter (Reflector)
# USDC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA        Circle USDC SAC
# USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# XLM=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC         XLM SAC
# THRESHOLD=0.005      act only when the pool deviates more than 0.5% from Reflector
# MAX_PRICE_AGE=900    seconds; an older (or missing) oracle price: nothing is done
# MAX_TRADE_USD=300    largest swap per run, in USD
# MIN_TRADE_USD=1      smaller swaps are skipped
# XLM_RESERVE=20       XLM never sold (fees)
# WARN_USDC=100        log a WARN line when the bot holds less USDC than this
# WARN_XLM=800         ... or less XLM than this
# SLIPPAGE=0.005       minimum output = router estimate less this
# FAIR_TOLERANCE=0.003 refuse when the estimate is worse than reference less fee by more than this
