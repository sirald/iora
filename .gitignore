target/
wasm/
.stellar/
.soroban/
node_modules/
.env
*.local
keeper/keeper.log
keeper/status.json
contracts/*/test_snapshots/

# Local files in the project root (secrets, notes, command sheets, old outputs) are not published.
# Only the files listed here are: everything else at the top level with these extensions stays local.
/*.env
/*.env*
/*.txt
/*.md
!/README.md

# Local backups and old launcher scripts
backups/
berthly.sh
moor.sh

# Build output: regenerated on every deploy
web/dist/

# Temporary copies of secret files, lock and state files
*.tmp
keeper/.env*

# One-off historical scripts
scripts/archive/

# Discord bot lives in its own repository
discord-bot/

# testnet/: only the settings the scripts read are published. Run logs, trial outputs and backups of earlier
# settings stay on the local machine.
testnet/*
!testnet/addr.env
!testnet/factory.env
!testnet/factory-sell.env
!testnet/old-factories.env
!testnet/generations.env
!testnet/markets.env
!testnet/batch.env
!testnet/filler.env
!testnet/pairs.env
